<!DOCTYPE html>
<html lang="en-us" data-theme="scope">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if page.doc_title %}{{ page.doc_title }}{% elsif page.title %}{{ page.title }} — Leo Huang{% else %}{{ site.title }}{% endif %}</title>
{% comment %} Description, canonical, share cards, favicon, fonts and JSON-LD: one include, shared
   with the case studies (layout: none) once they move onto it. {% endcomment %}
{% include scope/head-meta.liquid %}
<link rel="stylesheet" href="/assets/scope.css">
<link rel="stylesheet" href="/assets/shell.css">
<link rel="stylesheet" href="/assets/enhancements.css">
{% comment %} Page-level CSS/JS hooks (revision 2026-10): list paths in front matter, e.g.
   extra_css: [/assets/pages/about.css]   extra_js: [/assets/pages/about.js]
   Keep page files in /assets/pages/ (NOT /assets/css/, which purgecss rewrites in the deploy build). {% endcomment %}
{% for css in page.extra_css %}<link rel="stylesheet" href="{{ css }}">
{% endfor %}
{% comment %} Analytics (GA4). On while google_analytics and enable_google_analytics are both set in _config.yml,
   which they are as of Oct 2026. Renders nothing when either is unset. {% endcomment %}
{% include scripts/analytics.liquid %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% include scope/header.liquid %}
<main id="main">
{{ content }}
</main>
{% include scope/footer.liquid %}
{% include scope/scripts.liquid %}
<script src="/assets/js/enhancements.js" defer></script>
{% for js in page.extra_js %}<script src="{{ js }}" defer></script>
{% endfor %}</body>
</html>
