{%- comment -%}
  Shared sticky topbar, used by the scope layout and by every case study. Set `scope_nav` in a
  page's front matter (about | projects | cv | publications | contact) to highlight the active link.
  aria-current is "page" on the page itself and "true" on a section's sub-pages (the case studies
  under Projects).
  Styles: assets/shell.css. The avatar is one plain WebP <img>: a <picture>/<source> pair comes out of
  the jekyll-link-attributes pass as <source>...</source>, which is invalid HTML.
{%- endcomment %}
<header class="topbar">
  <div class="wrap">
    <a href="/" class="wordmark"><span class="dot"></span><img class="avatar" src="/assets/img/leo-avatar-104.webp" alt="" width="26" height="26" decoding="async">Leo&nbsp;Huang</a>
    <nav class="main" aria-label="Main">
      <a href="/"{% if page.scope_nav == 'about' %} class="active" aria-current="{% if page.url == '/' %}page{% else %}true{% endif %}"{% endif %}>About</a>
      <a href="/projects/"{% if page.scope_nav == 'projects' %} class="active" aria-current="{% if page.url == '/projects/' %}page{% else %}true{% endif %}"{% endif %}>Projects</a>
      <a href="/cv/"{% if page.scope_nav == 'cv' %} class="active" aria-current="{% if page.url == '/cv/' %}page{% else %}true{% endif %}"{% endif %}>Résumé</a>
      <a href="/publications/"{% if page.scope_nav == 'publications' %} class="active" aria-current="{% if page.url == '/publications/' %}page{% else %}true{% endif %}"{% endif %}>Publications</a>
      <a href="/contact/"{% if page.scope_nav == 'contact' %} class="active" aria-current="{% if page.url == '/contact/' %}page{% else %}true{% endif %}"{% endif %}>Contact</a>
    </nav>
  </div>
</header>
