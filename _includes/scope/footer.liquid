<!-- Shared footer: copyright only. A page can add a second line by setting
     `footer_coords` in its front matter (none does since 2026-11). -->
<footer class="foot">
  <div class="foot-inner">
    <span>© 2026 Leo Huang</span>
    {% if page.footer_coords %}<span class="coords">{{ page.footer_coords }}</span>{% endif %}
  </div>
</footer>
